# Copy to .env for local development. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=
EMBEDDING_MODEL=text-embedding-3-small
TYPESAFE_API_KEY=
JIRA_SERVER=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUP
JIRA_REQUESTER_FIELD_ID=customfield_10062
JIRA_REQUESTER_FIELD_NAME=Requester Email
JIRA_ISSUE_TYPE=Task
# true only if the project's create screen has a Priority field
JIRA_SET_PRIORITY_FIELD=false
DATABASE_URL=
# At least 32 random characters, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=8
# JSON list: [{"email":"alice@buzztech.example","name":"Alice Demo","password":"at-least-12-chars"}]
DEMO_USERS=
APP_ENV=local
RETRIEVAL_TOP_K=5
# Provisional; tune with scripts/inspect_retrieval.py --evaluate on real embeddings
RETRIEVAL_SCORE_THRESHOLD=0.30
# Answer cache (optional). Needs a Redis with the search module: Redis 8, or Redis Stack.
#   docker run -d --name tier0-redis -p 127.0.0.1:6379:6379 redis:8
# Leave REDIS_URL empty to run without a cache. Use rediss:// for a TLS connection.
REDIS_URL=
# How alike two questions must be (0.5 to 1.0) for one to reuse the other's answer. The same
# question (ignoring capitals and punctuation) is always reused. Tune with
# scripts/inspect_semantic_cache.py; the default suits text-embedding-3-small.
SEMANTIC_CACHE_SIMILARITY=0.88
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_TIMEOUT_SECONDS=0.5
# LangSmith tracing and feedback (optional). Every chat turn is traced to the project
# <LANGSMITH_AGENT_ID>-<environment>, where the environment comes from APP_ENV (local, staging,
# production). Personal details are masked before anything leaves the server. See docs/langsmith.md.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ID=tier0-support-agent
# Not read by the app. Leave unset: an invalid value here (for example "stage") makes the
# LangSmith library trace on its own to a project that does not exist.
# LANGSMITH_AGENT_ENVIRONMENT=

# Database tests (optional locally; always on in CI)
TIER0_TEST_DATABASE_URL=
RUN_MIGRATIONS_ON_START=true
CHAT_MESSAGES_PER_MINUTE=20
VECTOR_STORE_PATH=.data/chroma
# Folder with the built web app (frontend/dist); the server serves it when set
STATIC_DIR=
# Test stack only (see docker-compose.yml); fakes are refused outside local/e2e
# LLM_PROVIDER=openai          # or fake
# TICKETING_PROVIDER=jira      # or fake
# E2E_TOKEN=                   # enables /api/_e2e/* when APP_ENV=e2e
# auto = readable text locally, JSON elsewhere
LOG_FORMAT=auto
LOG_LEVEL=INFO
# Reverse proxies in front of the app (0 locally, 1 behind Azure Container Apps)
TRUSTED_PROXY_HOPS=0
MAX_REQUEST_BYTES=65536
